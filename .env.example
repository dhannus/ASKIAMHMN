# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=https://ask.iamhmn.org
NODE_ENV=production

# ─── HHTTPS OAuth ───────────────────────────────────────────────────────────
HHTTPS_BASE=https://hhttps.org
HHTTPS_CLIENT_ID=ask-iamhmn
# Leave empty for public client (uses PKCE only). Set for confidential client.
HHTTPS_CLIENT_SECRET=

# ─── Session ────────────────────────────────────────────────────────────────
# Random 32+ char string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-random-hex-string

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=askhuman
DB_USER=askhuman
DB_PASSWORD=replace-me-with-strong-password
